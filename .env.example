# SaferStreets environment variables. Copy to .env and fill in. Never commit real values.
# Each environment (local, staging, production) has its own database and secrets (Part B10).

# --- Database ---
# Postgres connection string for the app (Postgres 15+). Defaults match docker-compose.yml (host port 5433).
DATABASE_URL=postgresql://saferstreets:saferstreets@localhost:5433/saferstreets
# Separate Postgres database used only by the test suites (truncated between tests).
TEST_DATABASE_URL=postgresql://saferstreets:saferstreets@localhost:5433/saferstreets_test

# --- Runtime ---
# Public origin of the web app; the API is served under it via the /api/* rewrite (Part B2).
APP_ORIGIN=http://localhost:3000
# Internal origin of the Express API that Next.js rewrites /api/* to.
API_ORIGIN=http://localhost:4000
# Port the Express server listens on (must match API_ORIGIN locally).
PORT=4000
# Which entrypoint behaviour to run from the API build: server (HTTP) or worker (pg-boss jobs).
ROLE=server
# development | test | production
NODE_ENV=development
# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Auth secrets ---
# Secret for session token handling; at least 32 random bytes (e.g. 64 hex chars).
SESSION_SECRET=
# Server secret used to HMAC-SHA256 OTP codes before storage (appendix 9); at least 32 random bytes.
OTP_HMAC_SECRET=

# --- Email (Part B8) ---
# resend (production), smtp (local mail catcher) or capture (store emails for tests, send nothing).
EMAIL_TRANSPORT=capture
# SMTP host and port for local Mailpit (docker compose up -d mailpit; inbox at http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
# Verified sending address, e.g. "SaferStreets <no-reply@example.com>".
EMAIL_FROM=
# Resend API key (required when EMAIL_TRANSPORT=resend).
RESEND_API_KEY=
# Signing secret used to verify Resend bounce/complaint webhooks.
RESEND_WEBHOOK_SECRET=

# --- Cloudflare Turnstile on the OTP request form (Part B7) ---
# Public site key rendered by the web app. Default is Cloudflares always-pass TEST key; use a real one in production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Secret key used by the API to verify Turnstile tokens. Default is Cloudflares always-pass TEST secret.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Uploads (Cloudinary, signed direct upload; Part B9) ---
# Cloudinary cloud name.
CLOUDINARY_CLOUD_NAME=
# Cloudinary API key used to sign upload parameters.
CLOUDINARY_API_KEY=
# Cloudinary API secret (server only).
CLOUDINARY_API_SECRET=

# --- Maps (MapLibre + MapTiler; Part B9) ---
# MapTiler key, restricted by allowed origins; geocoding is proxied through the API.
MAPTILER_KEY=

# --- Observability (Part B6) ---
# Sentry DSN for the Next.js web app.
SENTRY_DSN_WEB=
# Sentry DSN for the Express API and worker.
SENTRY_DSN_API=

# --- SafeRoute routing (pick one; without either, /api/v1/saferoute/routes returns 503) ---
# OpenRouteService API key (free tier: https://openrouteservice.org/).
OPENROUTESERVICE_API_KEY=
# OSRM base URL (e.g. https://router.project-osrm.org or a self-hosted OSRM instance).
ROUTING_API_URL=
