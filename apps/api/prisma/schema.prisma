// SaferStreets database schema: appendix-06 6.2 + Part B4.
// CHECK constraints, the journeys partial UNIQUE index and the moderation_actions
// append-only trigger cannot be expressed here; they live as raw SQL in the migrations.
// Every foreign key has a covering index (asserted by test/schema/catalog.test.ts).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums (6.1 + B4)

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum ReportCategory {
  BROKEN_STREETLIGHT
  POOR_LIGHTING
  POTHOLE
  DAMAGED_ROAD
  DAMAGED_FOOTPATH
  ISOLATED_AREA
  OTHER
}

enum ReportStatus {
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum RideStatus {
  OPEN
  FULL
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RideRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

enum JourneyStatus {
  ACTIVE
  OVERDUE
  COMPLETED
  CANCELLED
}

enum AlertCategory {
  ROAD_ACCIDENT
  MEDICAL
  HARASSMENT
  FIRE
  PUBLIC_HAZARD
  OTHER
}

enum AlertStatus {
  ACTIVE
  VERIFIED
  RESOLVED
  DISMISSED
  EXPIRED
  REMOVED
}

enum SosEventStatus {
  ACTIVE
  RESOLVED
  CANCELLED
}

enum NotificationType {
  REPORT_STATUS
  REPORT_CONFIRMED
  RIDE_REQUEST
  RIDE_DECISION
  RIDE_UPDATE
  RIDE_MESSAGE
  JOURNEY_REMINDER
  JOURNEY_OVERDUE
  ALERT_NEARBY
  ALERT_UPDATE
  MODERATION
  SYSTEM
}

enum FlagTargetType {
  REPORT
  RIDE
  ALERT
  USER
  RIDE_MESSAGE
}

enum FlagStatus {
  OPEN
  ACTIONED
  DISMISSED
}

enum JourneyEventType {
  STARTED
  EXTENDED
  REMINDER_SENT
  CONTACT_NOTIFIED
  DEVIATED
  STOPPED
  LOST_SIGNAL
  SOS_TRIGGERED
  COMPLETED
  CANCELLED
}

enum AlertVoteType {
  CONFIRM
  DISPUTE
}

enum ModerationActionType {
  VERIFY
  REJECT
  RESOLVE
  DISMISS
  REMOVE
  WARN
  STRIKE
  SUSPEND
  BAN
  RESTORE
  ROLE_CHANGE
  SETTINGS_CHANGE
  FLAG_RESOLVE
  STATUS_CHANGE
}

enum UploadPurpose {
  REPORT
  ALERT
  AVATAR
}

enum UploadStatus {
  PENDING
  ATTACHED
  ORPHANED
}

enum EmailEventStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  FAILED
}

enum EmailSuppressionReason {
  BOUNCED
  COMPLAINED
  UNSUBSCRIBED
}

enum ConsentType {
  TERMS
  PRIVACY
  ALERT_OPTIN
}

// ---------------------------------------------------------------- identity

model User {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String     @unique @db.Citext
  emailVerifiedAt      DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  fullName             String?    @map("full_name") @db.VarChar(60)
  phone                String?    @db.VarChar(15)
  avatarUrl            String?    @map("avatar_url")
  role                 UserRole   @default(USER)
  status               UserStatus @default(ACTIVE)
  termsAcceptedAt      DateTime?  @map("terms_accepted_at") @db.Timestamptz(6)
  strikeCount          Int        @default(0) @map("strike_count")
  alertsSuspendedUntil DateTime?  @map("alerts_suspended_until") @db.Timestamptz(6)
  prefs                Json       @default("{}")
  lastLoginAt          DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?  @map("deleted_at") @db.Timestamptz(6)

  sessions            Session[]
  emergencyContacts   EmergencyContact[]
  reports             Report[]
  reportConfirmations ReportConfirmation[]
  reportStatusChanges ReportStatusHistory[]
  rides               Ride[]
  rideRequests        RideRequest[]
  rideParticipations  RideParticipant[]
  rideMessages        RideMessage[]
  rideWaitlist        RideWaitlist[]
  journeys            Journey[]
  alerts              Alert[]                @relation("AlertAuthor")
  alertsVerified      Alert[]                @relation("AlertVerifier")
  alertVotes          AlertVote[]
  alertSubscription   AlertSubscription?
  notifications       Notification[]
  flagsFiled          Flag[]                 @relation("FlagReporter")
  flagsResolved       Flag[]                 @relation("FlagResolver")
  moderationActions   ModerationAction[]
  settingsUpdated     SystemSetting[]
  idempotencyKeys     IdempotencyKey[]
  blocksMade          UserBlock[]            @relation("Blocker")
  blocksReceived      UserBlock[]            @relation("Blocked")
  sosEvents           SosEvent[]
  uploads             Upload[]
  consents            Consent[]

  @@index([status])
  @@map("users")
}

model OtpCode {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String    @db.Citext
  codeHash   String    @map("code_hash") @db.VarChar(128)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  ip         String?   @db.VarChar(45)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([email, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("otp_codes")
}

model Session {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  userAgent String?   @map("user_agent") @db.VarChar(512)
  ip        String?   @db.VarChar(45)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model EmergencyContact {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  name             String    @db.VarChar(60)
  relationship     String?   @db.VarChar(40)
  email            String    @db.Citext
  phone            String?   @db.VarChar(15)
  consentConfirmed Boolean   @map("consent_confirmed")
  unsubscribedAt   DateTime? @map("unsubscribed_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  journeys Journey[]

  @@unique([userId, email])
  @@map("emergency_contacts")
}

// ---------------------------------------------------------------- SafeRoute

model Report {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId          String         @map("author_id") @db.Uuid
  category          ReportCategory
  title             String         @db.VarChar(80)
  description       String
  latitude          Decimal        @db.Decimal(9, 6)
  longitude         Decimal        @db.Decimal(9, 6)
  addressText       String?        @map("address_text") @db.VarChar(200)
  status            ReportStatus   @default(SUBMITTED)
  confirmationCount Int            @default(0) @map("confirmation_count")
  moderatorNote     String?        @map("moderator_note")
  resolvedAt        DateTime?      @map("resolved_at") @db.Timestamptz(6)
  version           Int            @default(0)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?      @map("deleted_at") @db.Timestamptz(6)

  author        User                  @relation(fields: [authorId], references: [id])
  photos        ReportPhoto[]
  confirmations ReportConfirmation[]
  statusHistory ReportStatusHistory[]

  @@index([status, createdAt(sort: Desc)])
  @@index([category])
  @@index([latitude, longitude])
  @@index([authorId])
  @@map("reports")
}

model ReportPhoto {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId   String   @map("report_id") @db.Uuid
  url        String
  storageKey String   @map("storage_key") @db.VarChar(255)
  width      Int?
  height     Int?
  position   Int      @db.SmallInt
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, position])
  @@map("report_photos")
}

model ReportConfirmation {
  reportId  String   @map("report_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reportId, userId])
  @@index([userId])
  @@map("report_confirmations")
}

model ReportStatusHistory {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId   String        @map("report_id") @db.Uuid
  fromStatus ReportStatus? @map("from_status")
  toStatus   ReportStatus  @map("to_status")
  changedBy  String        @map("changed_by") @db.Uuid
  note       String?
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [changedBy], references: [id])

  @@index([reportId, createdAt])
  @@index([changedBy])
  @@map("report_status_history")
}

// ---------------------------------------------------------------- AutoMate

model Ride {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorId          String     @map("creator_id") @db.Uuid
  sourceText         String     @map("source_text") @db.VarChar(200)
  sourceLat          Decimal    @map("source_lat") @db.Decimal(9, 6)
  sourceLng          Decimal    @map("source_lng") @db.Decimal(9, 6)
  destText           String     @map("dest_text") @db.VarChar(200)
  destLat            Decimal    @map("dest_lat") @db.Decimal(9, 6)
  destLng            Decimal    @map("dest_lng") @db.Decimal(9, 6)
  departureAt        DateTime   @map("departure_at") @db.Timestamptz(6)
  seatsTotal         Int        @map("seats_total") @db.SmallInt
  seatsTaken         Int        @default(0) @map("seats_taken") @db.SmallInt
  estimatedTotalFare Int        @map("estimated_total_fare")
  note               String?    @db.VarChar(300)
  womenOnly          Boolean    @default(false) @map("women_only")
  status             RideStatus @default(OPEN)
  cancelReason       String?    @map("cancel_reason") @db.VarChar(300)
  version            Int        @default(0)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator      User              @relation(fields: [creatorId], references: [id])
  requests     RideRequest[]
  participants RideParticipant[]
  messages     RideMessage[]
  waitlist     RideWaitlist[]

  @@index([status, departureAt])
  @@index([sourceLat, sourceLng])
  @@index([destLat, destLng])
  @@index([creatorId])
  @@map("rides")
}

model RideRequest {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rideId    String            @map("ride_id") @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  message   String?           @db.VarChar(300)
  status    RideRequestStatus @default(PENDING)
  decidedAt DateTime?         @map("decided_at") @db.Timestamptz(6)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([rideId, userId])
  @@index([userId, status])
  @@map("ride_requests")
}

model RideParticipant {
  rideId    String    @map("ride_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  joinedAt  DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt    DateTime? @map("left_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@id([rideId, userId])
  @@index([userId])
  @@map("ride_participants")
}

/// [OPT] ride chat (appendix-06 6.2)
model RideMessage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rideId    String   @map("ride_id") @db.Uuid
  senderId  String   @map("sender_id") @db.Uuid
  body      String   @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  ride   Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id])

  @@index([rideId, createdAt])
  @@index([senderId])
  @@map("ride_messages")
}

/// [OPT] waitlist for full rides (Part B4)
model RideWaitlist {
  rideId    String   @map("ride_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([rideId, userId])
  @@index([userId])
  @@map("ride_waitlist")
}

// ---------------------------------------------------------------- JourneyGuard

model Journey {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String        @map("user_id") @db.Uuid
  /// Required by the API; nullable so deleting a contact does not block journey history.
  emergencyContactId  String?       @map("emergency_contact_id") @db.Uuid
  destinationText     String        @map("destination_text") @db.VarChar(200)
  destLat             Decimal?      @map("dest_lat") @db.Decimal(9, 6)
  destLng             Decimal?      @map("dest_lng") @db.Decimal(9, 6)
  startText           String?       @map("start_text") @db.VarChar(200)
  startLat            Decimal?      @map("start_lat") @db.Decimal(9, 6)
  startLng            Decimal?      @map("start_lng") @db.Decimal(9, 6)
  trackingEnabled     Boolean       @default(false) @map("tracking_enabled")
  routeGeometry       Json?         @map("route_geometry")
  lastLat             Decimal?      @map("last_lat") @db.Decimal(9, 6)
  lastLng             Decimal?      @map("last_lng") @db.Decimal(9, 6)
  lastLocationAt      DateTime?     @map("last_location_at") @db.Timestamptz(6)
  safetyState         String        @default("NORMAL") @map("safety_state") @db.VarChar(32)
  sosTriggeredAt      DateTime?     @map("sos_triggered_at") @db.Timestamptz(6)
  notes               String?       @db.VarChar(300)
  startedAt           DateTime      @default(now()) @map("started_at") @db.Timestamptz(6)
  expectedArrivalAt   DateTime      @map("expected_arrival_at") @db.Timestamptz(6)
  extensionsUsed      Int           @default(0) @map("extensions_used") @db.SmallInt
  status              JourneyStatus @default(ACTIVE)
  overdueAt           DateTime?     @map("overdue_at") @db.Timestamptz(6)
  contactNotifiedAt   DateTime?     @map("contact_notified_at") @db.Timestamptz(6)
  completedAt         DateTime?     @map("completed_at") @db.Timestamptz(6)
  trackTokenHash      String        @unique @map("track_token_hash") @db.VarChar(128)
  trackTokenExpiresAt DateTime      @map("track_token_expires_at") @db.Timestamptz(6)
  escalationMinutes   Int           @default(30) @map("escalation_minutes") @db.SmallInt
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user             User              @relation(fields: [userId], references: [id])
  emergencyContact EmergencyContact? @relation(fields: [emergencyContactId], references: [id], onDelete: SetNull)
  events           JourneyEvent[]
  locations        JourneyLocation[]

  @@index([userId])
  @@index([emergencyContactId])
  @@index([status, expectedArrivalAt])
  @@map("journeys")
}

model JourneyEvent {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  journeyId String           @map("journey_id") @db.Uuid
  type      JourneyEventType
  meta      Json             @default("{}")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  journey Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([journeyId, createdAt])
  @@map("journey_events")
}

model JourneyLocation {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  journeyId  String   @map("journey_id") @db.Uuid
  latitude   Decimal  @db.Decimal(9, 6)
  longitude  Decimal  @db.Decimal(9, 6)
  accuracyM  Float?   @map("accuracy_m")
  speedMps   Float?   @map("speed_mps")
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  journey Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([journeyId, recordedAt(sort: Desc)])
  @@map("journey_locations")
}

// ---------------------------------------------------------------- SafeAlert

model Alert {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId         String        @map("author_id") @db.Uuid
  category         AlertCategory
  description      String        @db.VarChar(500)
  latitude         Decimal       @db.Decimal(9, 6)
  longitude        Decimal       @db.Decimal(9, 6)
  addressText      String        @map("address_text") @db.VarChar(200)
  photoUrl         String?       @map("photo_url")
  status           AlertStatus   @default(ACTIVE)
  isAnonymous      Boolean       @default(true) @map("is_anonymous")
  confirmCount     Int           @default(0) @map("confirm_count")
  disputeCount     Int           @default(0) @map("dispute_count")
  needsReviewFirst Boolean       @default(false) @map("needs_review_first")
  verifiedBy       String?       @map("verified_by") @db.Uuid
  resolvedAt       DateTime?     @map("resolved_at") @db.Timestamptz(6)
  expiresAt        DateTime      @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  author   User        @relation("AlertAuthor", fields: [authorId], references: [id])
  verifier User?       @relation("AlertVerifier", fields: [verifiedBy], references: [id])
  votes    AlertVote[]

  @@index([status, createdAt(sort: Desc)])
  @@index([latitude, longitude])
  @@index([authorId])
  @@index([verifiedBy])
  @@index([status, expiresAt])
  @@map("alerts")
}

model AlertVote {
  alertId   String        @map("alert_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  vote      AlertVoteType
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([alertId, userId])
  @@index([userId])
  @@map("alert_votes")
}

model AlertSubscription {
  userId         String          @id @map("user_id") @db.Uuid
  enabled        Boolean         @default(false)
  sosNearbyOptIn Boolean         @default(false) @map("sos_nearby_opt_in")
  centerLat      Decimal?        @map("center_lat") @db.Decimal(9, 6)
  centerLng      Decimal?        @map("center_lng") @db.Decimal(9, 6)
  radiusKm       Int             @default(3) @map("radius_km") @db.SmallInt
  categories     AlertCategory[] @default([])
  emailEnabled   Boolean         @default(true) @map("email_enabled")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([enabled, centerLat, centerLng])
  @@map("alert_subscriptions")
}

model SosEvent {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  latitude      Decimal        @db.Decimal(9, 6)
  longitude     Decimal        @db.Decimal(9, 6)
  radiusKm      Int            @default(3) @map("radius_km") @db.SmallInt
  status        SosEventStatus @default(ACTIVE)
  notifiedCount Int            @default(0) @map("notified_count")
  resolvedAt    DateTime?      @map("resolved_at") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, createdAt(sort: Desc)])
  @@map("sos_events")
}

// ---------------------------------------------------------------- notifications, moderation

model Notification {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  type        NotificationType
  title       String           @db.VarChar(160)
  body        String
  link        String?          @db.VarChar(512)
  data        Json             @default("{}")
  readAt      DateTime?        @map("read_at") @db.Timestamptz(6)
  emailSentAt DateTime?        @map("email_sent_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEvents EmailEvent[]

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

model Flag {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId     String         @map("reporter_id") @db.Uuid
  targetType     FlagTargetType @map("target_type")
  /// Polymorphic: no database FK, integrity enforced in the service layer (appendix-06 6.3).
  targetId       String         @map("target_id") @db.Uuid
  reason         String         @db.VarChar(300)
  status         FlagStatus     @default(OPEN)
  resolvedBy     String?        @map("resolved_by") @db.Uuid
  resolutionNote String?        @map("resolution_note") @db.VarChar(500)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  reporter User  @relation("FlagReporter", fields: [reporterId], references: [id])
  resolver User? @relation("FlagResolver", fields: [resolvedBy], references: [id])

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([resolvedBy])
  @@map("flags")
}

/// Audit log. Append-only: a database trigger rejects UPDATE, and DELETE of rows younger than 2 years.
model ModerationAction {
  id         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String               @map("actor_id") @db.Uuid
  action     ModerationActionType
  targetType String               @map("target_type") @db.VarChar(32)
  targetId   String?              @map("target_id") @db.VarChar(64)
  reason     String
  meta       Json                 @default("{}")
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  actor User @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt(sort: Desc)])
  @@map("moderation_actions")
}

model SystemSetting {
  key       String   @id @db.VarChar(64)
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  updater User? @relation(fields: [updatedBy], references: [id])

  @@index([updatedBy])
  @@map("system_settings")
}

// ---------------------------------------------------------------- Part B4 additions

model IdempotencyKey {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key            String   @db.VarChar(255)
  userId         String   @map("user_id") @db.Uuid
  method         String   @db.VarChar(10)
  path           String   @db.VarChar(512)
  requestHash    String   @map("request_hash") @db.VarChar(128)
  /// NULL while the original request is still in flight.
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model UserBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model Upload {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  purpose    UploadPurpose
  storageKey String        @unique @map("storage_key") @db.VarChar(255)
  status     UploadStatus  @default(PENDING)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, createdAt])
  @@map("uploads")
}

model EmailEvent {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId String?          @map("notification_id") @db.Uuid
  /// SHA-256 of the lower-cased recipient address; the address itself is never stored here.
  toHash         String           @map("to_hash") @db.VarChar(64)
  template       String           @db.VarChar(64)
  providerId     String?          @map("provider_id") @db.VarChar(128)
  status         EmailEventStatus @default(QUEUED)
  error          String?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@index([notificationId])
  @@index([providerId])
  @@index([toHash, createdAt])
  @@map("email_events")
}

model EmailSuppression {
  id        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// SHA-256 of the lower-cased address, checked before every send.
  emailHash String                 @unique @map("email_hash") @db.VarChar(64)
  reason    EmailSuppressionReason
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("email_suppressions")
}

model Heartbeat {
  name       String   @id @db.VarChar(64)
  lastSeenAt DateTime @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("heartbeats")
}

model Consent {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  type       ConsentType
  version    String      @db.VarChar(32)
  acceptedAt DateTime    @default(now()) @map("accepted_at") @db.Timestamptz(6)
  ipHash     String?     @map("ip_hash") @db.VarChar(64)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("consents")
}

/// Store for rate-limiter-flexible (RateLimiterPostgres, tableCreated: true). Shared across instances.
model RateLimit {
  key    String @id @db.VarChar(255)
  points Int    @default(0)
  expire BigInt?

  @@index([expire])
  @@map("rate_limits")
}

/// Written only by the `capture` mail transport (local dev and tests). Never used in production.
model CapturedEmail {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  toEmail   String   @map("to_email") @db.Citext
  subject   String   @db.VarChar(200)
  textBody  String   @map("text_body")
  htmlBody  String   @map("html_body")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([toEmail, createdAt(sort: Desc)])
  @@map("captured_emails")
}
